---
import { SITE, NAV } from '../consts';
import { url } from '../lib/url';
const year = new Date().getFullYear();

/**
 * Liens légaux et de transparence, obligatoires en pied de page.
 * `/methodologie` et `/politique-affiliation` y figurent au même titre que les
 * mentions légales : ce sont les pages qui rendent le site vérifiable.
 */
const LEGAL_LINKS: { label: string; href: string }[] = [
  { label: 'Méthodologie', href: '/methodologie' },
  { label: "Politique d'affiliation", href: '/politique-affiliation' },
  { label: 'Mentions légales', href: '/mentions-legales' },
  { label: 'Confidentialité', href: '/confidentialite' },
  { label: 'Contact', href: '/contact' },
  { label: 'À propos', href: '/a-propos' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-brand">
        <svg viewBox="0 0 40 32" width="22" height="18" aria-hidden="true" style="vertical-align:-3px">
          <defs>
            <linearGradient id="eqFoot" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#4f8cff" />
              <stop offset="1" stop-color="#25d0a4" />
            </linearGradient>
          </defs>
          <rect x="0" y="18" width="6" height="14" rx="3" fill="url(#eqFoot)" />
          <rect x="9" y="8" width="6" height="24" rx="3" fill="url(#eqFoot)" />
          <rect x="18" y="0" width="6" height="32" rx="3" fill="url(#eqFoot)" />
          <rect x="27" y="10" width="6" height="22" rx="3" fill="url(#eqFoot)" />
          <rect x="34" y="20" width="6" height="12" rx="3" fill="url(#eqFoot)" />
        </svg>
        {SITE.name}
      </p>
      <p class="footer-tagline">{SITE.tagline}</p>
    </div>
    <nav aria-label="Navigation pied de page">
      <ul>
        {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer-legal">
      <nav aria-label="Informations légales">
        <ul class="footer-legal-links">
          {
            LEGAL_LINKS.map((item) => (
              <li>
                <a href={url(item.href)}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p>
        Site éditorial indépendant. Certains liens peuvent être affiliés ; cela
        n'influence pas nos classements —
        <a href={url('/politique-affiliation')}>notre politique d'affiliation</a>.
      </p>
      <p>© {year} {SITE.name}. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-soft);
    margin-top: var(--space-16);
    padding-block: var(--space-12);
  }
  .footer-grid {
    display: grid;
    gap: var(--space-8);
  }
  @media (min-width: 720px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1.5fr;
    }
  }
  .footer-brand {
    font-weight: 800;
    margin-bottom: var(--space-1);
  }
  .footer-tagline {
    color: var(--text-muted);
    margin: 0;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .site-footer li {
    margin-bottom: var(--space-2);
  }
  .footer-legal p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }
  /* Liens légaux : 1rem (16 px), au-dessus du plancher de taille de texte, et
     séparateur décoratif masqué aux lecteurs d'écran. */
  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    font-size: 1rem;
  }
  .footer-legal-links li {
    margin-bottom: 0;
  }
  .footer-legal-links li:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-3);
    color: var(--text-muted);
  }
</style>
