---
/**
 * Visuel génératif réutilisable (sans photo, donc sans souci de copyright).
 * Chaque `seed` (slug, titre…) produit un dégradé + un motif d'égaliseur unique
 * mais cohérent avec l'identité du site. Purement décoratif (aria-hidden).
 */
interface Props {
  seed: string;
  /** Format : 'banner' (3:1, en-tête) ou 'thumb' (16:9, vignette de carte). */
  variant?: 'banner' | 'thumb';
  /** Petit pictogramme optionnel affiché au centre. */
  icon?: string;
  class?: string;
}
const { seed, variant = 'banner', icon, class: className } = Astro.props;

// Hash déterministe à partir du seed.
let h = 0;
for (const c of seed) h = (h * 31 + c.charCodeAt(0)) >>> 0;

// Générateur pseudo-aléatoire déterministe (mulberry32).
function rng(s: number) {
  return () => {
    s |= 0;
    s = (s + 0x6d2b79f5) | 0;
    let t = Math.imul(s ^ (s >>> 15), 1 | s);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(h);

const hue = h % 360;
const hue2 = (hue + 50) % 360;
const c1 = `hsl(${hue} 72% 55%)`;
const c2 = `hsl(${hue2} 70% 48%)`;

const barCount = 30;
const bars = Array.from({ length: barCount }, () => 40 + Math.round(rand() * 230));
const gid = `cv${h.toString(36)}`;
---

<div class:list={['cover', `cover-${variant}`, className]} aria-hidden="true">
  <svg viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" role="presentation">
    <defs>
      <linearGradient id={`${gid}g`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color={c1} />
        <stop offset="1" stop-color={c2} />
      </linearGradient>
      <linearGradient id={`${gid}v`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#0b0e14" stop-opacity="0" />
        <stop offset="1" stop-color="#0b0e14" stop-opacity="0.55" />
      </linearGradient>
    </defs>
    <rect width="1200" height="400" fill={`url(#${gid}g)`} />
    {/* ondes sonores */}
    <path
      d="M0 250 q 60 -70 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0"
      fill="none"
      stroke="rgba(255,255,255,0.22)"
      stroke-width="4"
    />
    <path
      d="M0 300 q 60 -50 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0 t 120 0"
      fill="none"
      stroke="rgba(255,255,255,0.14)"
      stroke-width="4"
    />
    {/* égaliseur */}
    {
      bars.map((bh, i) => (
        <rect
          x={10 + i * 40}
          y={400 - bh}
          width="22"
          height={bh}
          rx="11"
          fill="rgba(255,255,255,0.16)"
        />
      ))
    }
    <rect width="1200" height="400" fill={`url(#${gid}v)`} />
    {icon && (
      <text
        x="600"
        y="225"
        font-size="150"
        text-anchor="middle"
        opacity="0.9"
      >
        {icon}
      </text>
    )}
  </svg>
</div>

<style>
  .cover {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface-2);
  }
  .cover-banner {
    aspect-ratio: 3 / 1;
  }
  .cover-thumb {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .cover svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
