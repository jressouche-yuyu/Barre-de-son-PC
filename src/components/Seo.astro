---
/**
 * Composant SEO centralisé.
 * Gère : title, meta description, canonical, robots, Open Graph, Twitter Card
 * et l'injection de données structurées JSON-LD (clé du GEO).
 */
import { SITE } from '../consts';
import { url } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  /** Chemin de la page (ex. "/classements"). Sert à construire l'URL canonique. */
  path?: string;
  /** Image Open Graph (chemin relatif ou absolu). */
  image?: string;
  /** Type Open Graph. */
  ogType?: 'website' | 'article';
  /** Empêche l'indexation si true. */
  noindex?: boolean;
  /** Tableau d'objets JSON-LD (schema.org) à injecter. */
  jsonLd?: Record<string, unknown>[];
  /** Date de publication ISO (articles). */
  publishedTime?: string;
  /** Date de modification ISO (articles). */
  modifiedTime?: string;
  /**
   * Force l'URL canonique vers un autre chemin que celui de la page.
   *
   * Utile quand deux URL servent volontairement le même contenu : l'édition
   * courante de la sélection du mois vit à la fois sur `/selection-du-mois/`
   * (la page d'atterrissage, qui a l'historique) et sur son URL d'archive
   * permanente. Sans canonique explicite, ce sont deux pages en doublon.
   */
  canonicalPath?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.defaultOgImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
  canonicalPath,
} = Astro.props;

// Origine du déploiement courant (domaine de prod, ou github.io en préversion).
const origin = Astro.site ?? new URL(SITE.url);
// `Astro.url.pathname` inclut déjà le base path éventuel → URL canonique fiable.
/**
 * URL canonique.
 *
 * Le slash final est normalisé : les pages du site sont servies avec (Astro
 * génère `<chemin>/index.html`), donc un canonique sans slash désignerait une
 * autre URL que la page visée — et un canonique qui ne pointe pas exactement
 * sur la page cible ne sert à rien.
 */
const withTrailingSlash = (path: string) =>
  path.endsWith('/') || /\.[a-z0-9]+$/i.test(path) ? path : `${path}/`;
const canonical = new URL(
  withTrailingSlash(canonicalPath ? url(canonicalPath) : Astro.url.pathname),
  origin,
).href;
const ogImage = image.startsWith('http') ? image : new URL(url(image), origin).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
// `SITE.noindex` force la non-indexation sur tout le site (préparation au lancement).
const isNoindex = SITE.noindex || noindex;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={isNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />

{/* Open Graph */}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{/* Données structurées JSON-LD — citables par les moteurs génératifs (GEO) */}
{
  jsonLd.map((schema) => (
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
