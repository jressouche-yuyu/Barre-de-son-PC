---
/**
 * Page d'atterrissage de « Notre sélection du mois ».
 *
 * Affiche l'édition en cours, et donne accès aux éditions archivées, qui ont
 * chacune leur URL permanente (`selection-du-mois/[id].astro`). C'est cette
 * page qui porte l'historique de référencement de la rubrique : elle reste donc
 * la version canonique de l'édition courante.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CoverArt from '../../components/CoverArt.astro';
import MonthlyEdition from '../../components/MonthlyEdition.astro';
import { monthlyEditions, latestEdition, statusLabel } from '../../data/monthly';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { SITE } from '../../consts';
import { url } from '../../lib/url';

const edition = latestEdition();
const archives = monthlyEditions.slice(1);

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Sélection du mois', path: '/selection-du-mois' },
];

const dateFmt = (iso: string) =>
  new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long', timeZone: 'UTC' }).format(
    new Date(`${iso.slice(0, 10)}T12:00:00Z`),
  );

const faq = [
  {
    question: 'À quelle fréquence la sélection est-elle mise à jour ?',
    answer:
      "Notre sélection du mois est actualisée au début de chaque mois. Nous indiquons clairement s'il y a de nouvelles entrées, des sorties récentes, ou si le marché est resté stable.",
  },
  {
    question: 'Peut-on consulter les sélections des mois précédents ?',
    answer:
      "Oui. Chaque édition conserve son adresse permanente et n'est jamais réécrite : vous pouvez comparer l'état du marché d'un mois à l'autre depuis la liste des éditions précédentes.",
  },
  {
    question: 'Que se passe-t-il un mois sans nouveauté ?',
    answer:
      "Nous le disons. Un mois sans sortie est publié avec le statut « marché stable » et la sélection reste la même : inventer une nouveauté pour remplir la rubrique n'aiderait personne.",
  },
];

// Liste ordonnée des éditions — surface de citation pour les moteurs génératifs,
// et signal explicite que la rubrique a bien une histoire mensuelle.
const editionsList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Éditions de la sélection du mois',
  numberOfItems: monthlyEditions.length,
  itemListOrder: 'https://schema.org/ItemListOrderDescending',
  itemListElement: monthlyEditions.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `Sélection du mois — ${e.label}`,
    url: new URL(url(`/selection-du-mois/${e.id}`), SITE.url).href,
  })),
};

const jsonLd = [breadcrumbSchema(crumbs), faqSchema(faq), editionsList];
---

<BaseLayout
  title={`Notre sélection du mois — ${edition.label}`}
  description={edition.headline}
  path="/selection-du-mois"
  ogType="article"
  modifiedTime={edition.publishedAt}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <CoverArt seed={`selection-${edition.id}`} variant="banner" icon="🗓️" class="sel-cover" />

    <header class="section" style="padding-top: var(--space-6); padding-bottom: var(--space-4)">
      <p class="eyebrow">Sélection du mois · {edition.label}</p>
      <h1>Notre sélection du mois</h1>
      <p class="lead">{edition.intro}</p>
    </header>

    <MonthlyEdition edition={edition} />

    {
      archives.length > 0 && (
        <section style="margin-top: var(--space-12)">
          <h2>Éditions précédentes</h2>
          <p class="muted">
            Chaque édition garde son adresse et n'est jamais réécrite : c'est ce qui permet de
            comparer l'état du marché d'un mois à l'autre.
          </p>
          <ul class="archive">
            {archives.map((e) => (
              <li>
                <a class="archive-link" href={url(`/selection-du-mois/${e.id}`)}>
                  <span class="archive-month">{e.label}</span>
                  <span class="archive-status">{statusLabel(e.status)}</span>
                </a>
                <p class="archive-headline">{e.headline}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="muted" style="margin-top: var(--space-12)">
      Rubrique actualisée au début de chaque mois. Édition en cours publiée le
      {' '}{dateFmt(edition.publishedAt)}.
    </p>
  </div>
</BaseLayout>

<style>
  .sel-cover {
    margin-top: var(--space-6);
  }
  .muted {
    color: var(--text-muted);
  }
  .archive {
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }
  .archive > li {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--border);
  }
  .archive > li:last-child {
    border-bottom: none;
  }
  .archive-link {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
    font-weight: 700;
  }
  .archive-month {
    font-size: 1.0625rem;
  }
  /* Le statut est un libellé, jamais une couleur seule. */
  .archive-status {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }
  .archive-headline {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
