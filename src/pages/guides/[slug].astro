---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CoverArt from '../../components/CoverArt.astro';
import Faq from '../../components/Faq.astro';
import { guides } from '../../data/guides';
import {
  breadcrumbSchema,
  articleSchema,
  faqSchema,
} from '../../lib/schema';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Guides', path: '/guides' },
  { name: guide.title, path: `/guides/${guide.slug}` },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  articleSchema(guide),
  faqSchema(guide.faq),
];
---

<BaseLayout
  title={guide.title}
  description={guide.description}
  path={`/guides/${guide.slug}`}
  ogType="article"
  publishedTime={guide.publishedAt}
  modifiedTime={guide.lastUpdated}
  jsonLd={jsonLd}
>
  <article class="container guide">
    <Breadcrumbs items={crumbs} />
    {
      guide.cover ? (
        <img
          class="guide-cover guide-cover-img"
          src={url(guide.cover)}
          alt={guide.coverAlt ?? guide.title}
          width="1600"
          height="900"
          loading="eager"
        />
      ) : (
        <CoverArt seed={`guide-${guide.slug}`} variant="banner" icon="📘" class="guide-cover" />
      )
    }
    <header class="section" style="padding-top: var(--space-6); padding-bottom: var(--space-4)">
      <h1>{guide.title}</h1>
      <p class="lead">{guide.description}</p>
      <p class="meta badge">{guide.readingMinutes} min · Mis à jour le {guide.lastUpdated}</p>
    </header>

    <div class="prose">
      {
        guide.sections.map((s) => (
          <section class="guide-section">
            <h2>{s.heading}</h2>
            <p set:html={s.body} />
          </section>
        ))
      }
    </div>

    <Faq items={guide.faq} />

    <p style="margin-top: var(--space-8)">
      <a class="btn btn-ghost" href={url('/guides')}>← Tous les guides</a>
    </p>
  </article>
</BaseLayout>

<style>
  .guide {
    max-width: 760px;
  }
  .guide-cover {
    margin-top: var(--space-6);
  }
  .guide-cover-img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }
  .prose {
    font-size: 1.06rem;
  }
  .guide-section {
    margin-bottom: var(--space-8);
  }
  .guide-section h2 {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }
  .guide-section p {
    color: var(--text);
    line-height: 1.75;
  }
</style>
