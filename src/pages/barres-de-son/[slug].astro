---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProsCons from '../../components/ProsCons.astro';
import Callout from '../../components/Callout.astro';
import Gallery from '../../components/Gallery.astro';
import PrixGamme from '../../components/PrixGamme.astro';
import { soundbars, powerLabel } from '../../data/soundbars';
import { formatCheckedAt, formatPriceBand, isPriceFresh, priceBand } from '../../lib/prix';
import { rankingsForSoundbar } from '../../data/rankings';
import { getGuide } from '../../data/guides';
import { getBrand } from '../../data/brands';
import {
  breadcrumbSchema,
  productReviewSchema,
  howToSchema,
} from '../../lib/schema';
import { url } from '../../lib/url';
import { goUrl } from '../../lib/affiliate';
import { AFFILIATE } from '../../consts';

export function getStaticPaths() {
  return soundbars.map((sb) => ({
    params: { slug: sb.slug },
    props: { sb },
  }));
}

const { sb } = Astro.props;

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Barres de son', path: '/barres-de-son' },
  { name: sb.name, path: `/barres-de-son/${sb.slug}` },
];

const scoreRows: { label: string; value: number }[] = [
  { label: 'Qualité sonore', value: sb.scores.son },
  { label: 'Basses', value: sb.scores.basses },
  { label: 'Ergonomie', value: sb.scores.ergonomie },
  { label: 'Connectique', value: sb.scores.connectique },
  { label: 'Rapport qualité-prix', value: sb.scores.rapportQualitePrix },
];

const specs: { label: string; value: string }[] = [
  { label: 'Marque', value: sb.brand },
  // Gamme et non prix exact : un prix exact affiché est faux la semaine
  // suivante. Et jamais de gamme sans sa date de relevé.
  ...(isPriceFresh(sb.priceCheckedAt)
    ? [
        { label: 'Gamme de prix', value: formatPriceBand(sb.price) },
        { label: 'Gamme relevée le', value: formatCheckedAt(sb.priceCheckedAt) },
      ]
    : [{ label: 'Gamme de prix', value: 'à revérifier — voir le prix chez le marchand' }]),
  { label: 'Haut-parleurs', value: sb.driverConfig },
  ...(sb.powerRmsWatts || sb.powerPeakWatts
    ? [{ label: 'Puissance', value: powerLabel(sb) }]
    : []),
  ...(sb.frequencyResponse
    ? [{ label: 'Réponse en fréquence', value: sb.frequencyResponse }]
    : []),
  { label: 'Connectique', value: sb.connectivity.join(', ') },
  { label: 'Caisson de basses', value: sb.hasSubwoofer ? 'Oui' : 'Non' },
  { label: 'Microphone', value: sb.hasMicrophone ? 'Oui' : 'Non' },
  { label: 'Éclairage RGB', value: sb.hasRGB ? 'Oui' : 'Non' },
  {
    label: 'Dimensions barre (L×H×P)',
    value: `${sb.dimensionsCm.width} × ${sb.dimensionsCm.height} × ${sb.dimensionsCm.depth} cm`,
  },
  { label: 'Année', value: String(sb.releaseYear) },
];

const brandInfo = getBrand(sb.brand.toLowerCase());
const inRankings = rankingsForSoundbar(sb.slug);

// Notice : lien direct si connu, sinon recherche ciblée sur le site officiel de la marque.
const supportDomain: Record<string, string> = {
  Razer: 'razer.com',
  Creative: 'creative.com',
  Edifier: 'edifier.com',
  Logitech: 'logitech.com',
  Trust: 'trust.com',
};
const domain = supportDomain[sb.brand];
const manualIsDirect = Boolean(sb.manualUrl);
const manualHref =
  sb.manualUrl ??
  `https://www.google.com/search?q=${encodeURIComponent(`${domain ? `site:${domain} ` : ''}${sb.name} manuel notice pdf`)}`;

// Point 3 — « Pour qui / Pas pour qui » (dérivé des caractéristiques).
const forYou: string[] = [
  sb.bestFor,
  ...(sb.hasRGB ? ['Vous voulez habiller un setup avec du RGB'] : []),
  ...(sb.hasMicrophone ? ['Vous enchaînez les visios (micro intégré)'] : []),
  ...(sb.connectivity.includes('HDMI ARC') ? ['Vous branchez aussi une TV ou une console'] : []),
  ...(sb.price <= 80 ? ['Vous cherchez le bon plan à petit prix'] : []),
].slice(0, 4);
const notForYou: string[] = [
  ...(!sb.hasSubwoofer ? ['Vous voulez des basses physiques puissantes (pas de caisson)'] : []),
  ...(!sb.connectivity.includes('Bluetooth') ? ['Vous voulez diffuser sans fil depuis un mobile (pas de Bluetooth)'] : []),
  ...(sb.dimensionsCm.width >= 56 ? ['Votre bureau est étroit (barre assez large)'] : []),
  ...(sb.price >= 250 ? ['Votre budget est serré'] : []),
  ...(!sb.hasRGB ? ['Vous tenez à un éclairage RGB'] : []),
].slice(0, 4);

// Point 1 — Alternatives intelligentes (calculées depuis le catalogue).
const others = soundbars.filter((s) => s.slug !== sb.slug);
const used = new Set<string>([sb.slug]);
const altList: { label: string; sb: typeof sb }[] = [];
const pushAlt = (label: string, cand: typeof sb | undefined) => {
  if (cand && !used.has(cand.slug)) {
    used.add(cand.slug);
    altList.push({ label, sb: cand });
  }
};
pushAlt('Moins chère', [...others].filter((s) => s.price < sb.price).sort((a, b) => b.score - a.score)[0]);
pushAlt('Montée en gamme', [...others].filter((s) => s.price > sb.price).sort((a, b) => b.score - a.score)[0]);
pushAlt(
  'Plus compacte',
  [...others].filter((s) => s.dimensionsCm.width < sb.dimensionsCm.width).sort((a, b) => a.dimensionsCm.width - b.dimensionsCm.width)[0],
);

// Point 6 — Puissance utile pour la pièce.
const watts = sb.powerRmsWatts ?? (sb.powerPeakWatts ? Math.round(sb.powerPeakWatts / 2) : 0);
const wattsKnown = watts > 0;
const relatedGuides = ['comment-choisir-barre-de-son-pc', 'comment-installer-barre-de-son-pc']
  .map((s) => getGuide(s))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

const jsonLd = [
  breadcrumbSchema(crumbs),
  productReviewSchema(sb),
  howToSchema(sb),
];
---

<BaseLayout
  title={`Test ${sb.name} : avis, prix et fiche technique`}
  description={sb.verdict}
  path={`/barres-de-son/${sb.slug}`}
  ogType="article"
  modifiedTime={sb.lastUpdated}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />

    <article class="product-hero">
      <div class="product-media">
        <a
          class:list={['brand-badge', brandInfo?.logoBg === 'dark' && 'badge-dark']}
          href={url(`/marques/${sb.brand.toLowerCase()}`)}
          aria-label={`Toutes les barres de son ${sb.brand}`}
        >
          {
            brandInfo?.logo ? (
              <img src={url(brandInfo.logo)} alt={`Logo ${sb.brand}`} height="18" loading="eager" />
            ) : (
              <span>{sb.brand}</span>
            )
          }
        </a>
        {
          sb.gallery && sb.gallery.length > 0 ? (
            <Gallery images={sb.gallery} name={sb.name} />
          ) : (
            <img
              class="product-image"
              src={url(sb.image)}
              alt={sb.imageAlt}
              width="1200"
              height="675"
              loading="eager"
            />
          )
        }
      </div>

      <div class="product-info">
        <h1>{sb.name}</h1>
        <p class="lead">{sb.verdict}</p>
        <p class="badge badge-accent">🎯 Idéal pour : {sb.bestFor}</p>

        <div class="buybox">
          <div class="buybox-score">
            <span class="score-big score">{sb.score.toFixed(1)}</span>
            <span class="score-out">/ 10</span>
          </div>
          <div class="buybox-buy">
            <PrixGamme sb={sb} />
            {
              AFFILIATE.enabled && (
                <a
                  class="btn buy-btn"
                  href={goUrl(sb.slug)}
                  target="_blank"
                  rel="sponsored nofollow noopener"
                >
                  Voir le prix sur Amazon
                </a>
              )
            }
          </div>
        </div>
      </div>
    </article>

    <Callout title="L'essentiel" icon="⚡">
      <ul>
        <li><strong>Idéal pour :</strong> {sb.bestFor}</li>
        <li><strong>Point fort :</strong> {sb.pros[0]}</li>
        <li><strong>À noter :</strong> {sb.cons[0]}</li>
        <li>
          <strong>Gamme :</strong> {priceBand(sb.price).label} ·
          <strong> Note :</strong> {sb.score.toFixed(1)}/10
        </li>
      </ul>
    </Callout>

    <h2>Notre avis</h2>
    <p>{sb.summary}</p>

    <ProsCons pros={sb.pros} cons={sb.cons} />

    <section class="audience grid grid-2" aria-label="Pour qui / pas pour qui">
      <div class="aud aud-yes">
        <h3>👍 Pour vous si…</h3>
        <ul>
          {forYou.map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="aud aud-no">
        <h3>👎 Passez votre chemin si…</h3>
        <ul>
          {notForYou.map((x) => <li>{x}</li>)}
        </ul>
      </div>
    </section>

    <h2>Notes détaillées</h2>
    <div class="scores">
      {
        scoreRows.map((row) => (
          <div class="score-row">
            <span class="score-label">{row.label}</span>
            <span class="score-bar" role="img" aria-label={`${row.value} sur 10`}>
              <span class="score-fill" style={`width:${row.value * 10}%`} />
            </span>
            <span class="score-val">{row.value.toFixed(1)}</span>
          </div>
        ))
      }
    </div>

    <h2>Fiche technique</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {
            specs.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td>{s.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="fit-check" aria-labelledby="fit-title">
      <h2 id="fit-title">📐 Tient-elle sous votre écran ?</h2>
      <p>
        La {sb.name} mesure <strong>{sb.dimensionsCm.width} cm</strong> de large.
        Renseignez la largeur de votre écran : le moniteur et la barre s'affichent
        à la même échelle, en 3D.
      </p>
      <div class="fit-controls">
        <label for="fit-input">Largeur de l'écran (cm)</label>
        <input type="number" id="fit-input" min="20" max="250" step="0.5" inputmode="decimal" value="60" />
        <span class="fit-hint">≈ 53 cm (24″) · 60 cm (27″) · 70 cm (32″) · 80 cm (34″ ultralarge)</span>
      </div>
      <div class="sim3d" aria-hidden="true">
        <div class="sim3d-stage">
          <div class="sim3d-monitor" id="sim-monitor">
            <div class="sim3d-screen"><span>Écran · <b id="sim-screen-cm"></b></span></div>
            <div class="sim3d-neck"></div>
            <div class="sim3d-foot"></div>
          </div>
          <div class="sim3d-bar" id="sim-bar"><span id="sim-bar-cm"></span></div>
        </div>
      </div>
      <p id="fit-result" class="fit-result" role="status" aria-live="polite"></p>
    </section>

    <section class="room-check" aria-labelledby="room-title">
      <h2 id="room-title">🔊 Adaptée à votre espace ?</h2>
      <p>Puissance de cette barre : <strong>{powerLabel(sb)}</strong>. Choisissez votre contexte d'écoute :</p>
      <div class="fit-controls">
        <label for="room-select">Contexte</label>
        <select id="room-select">
          <option value="bureau">Petit bureau (écoute de près)</option>
          <option value="grand-bureau">Grand bureau</option>
          <option value="petite-piece">Petite pièce (~10-15 m²)</option>
          <option value="grande-piece">Grande pièce / salon</option>
        </select>
      </div>
      <p id="room-result" class="fit-result" role="status" aria-live="polite"></p>
    </section>

    <h2>Tutoriel : installer et configurer la {sb.name}</h2>
    <p>{sb.tutorial.intro}</p>
    <ol class="tuto-steps">
      {
        sb.tutorial.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    {
      sb.tutorial.tips && sb.tutorial.tips.length > 0 && (
        <div class="tuto-tips">
          <h3>Astuces</h3>
          <ul>
            {sb.tutorial.tips.map((tip) => <li>{tip}</li>)}
          </ul>
        </div>
      )
    }

    {
      altList.length > 0 && (
        <section class="alternatives">
          <h2>Alternatives à considérer</h2>
          <div class="alt-grid">
            {altList.map((a) => (
              <a class="alt-card" href={url(`/barres-de-son/${a.sb.slug}`)}>
                <span class="alt-label">{a.label}</span>
                <img src={url(a.sb.image)} alt={a.sb.name} width="320" height="180" loading="lazy" />
                <span class="alt-name">{a.sb.name}</span>
                <span class="alt-meta">{priceBand(a.sb.price).label} · {a.sb.score.toFixed(1)}/10</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="notice">
      <h2>📘 Notice &amp; support</h2>
      <p>
        Besoin du manuel d'utilisation de la {sb.name} (branchements, réglages,
        dépannage) ?
      </p>
      <a class="btn btn-ghost" href={manualHref} target="_blank" rel="noopener nofollow">
        {manualIsDirect ? '📄 Télécharger la notice (PDF)' : '🔎 Trouver la notice officielle'}
      </a>
    </section>

    <p class="updated">Fiche vérifiée le {sb.lastUpdated}.</p>

    <section class="maillage grid grid-2">
      {
        inRankings.length > 0 && (
          <div>
            <h2>La {sb.name} dans nos classements</h2>
            <ul>
              {inRankings.map((r) => (
                <li><a href={url(`/classements/${r.slug}`)}>{r.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }
      <div>
        <h2>Guides utiles</h2>
        <ul>
          {relatedGuides.map((g) => (
            <li><a href={url(`/guides/${g.slug}`)}>{g.title}</a></li>
          ))}
          <li><a href={url('/comparateur')}>Comparer toutes les barres de son PC</a></li>
        </ul>
      </div>
    </section>

    <p style="margin-top: var(--space-8)">
      <a class="btn btn-ghost" href={url('/barres-de-son')}>← Toutes les barres de son</a>
    </p>
  </div>

  <script is:inline define:vars={{ barWidth: sb.dimensionsCm.width, watts, wattsKnown }}>
    // Simulateur visuel « tient sous votre écran »
    const input = document.getElementById('fit-input');
    const result = document.getElementById('fit-result');
    const monitor = document.getElementById('sim-monitor');
    const simBar = document.getElementById('sim-bar');
    const simCm = document.getElementById('sim-bar-cm');
    const simScreenCm = document.getElementById('sim-screen-cm');
    function checkFit() {
      const screenW = parseFloat((input?.value || '').replace(',', '.'));
      if (!result || !simBar || !monitor) return;
      if (!screenW || screenW <= 0) {
        result.textContent = 'Renseignez la largeur de votre écran.';
        result.className = 'fit-result';
        return;
      }
      const maxW = Math.max(screenW, barWidth);
      monitor.style.width = ((screenW / maxW) * 100).toFixed(1) + '%';
      simBar.style.width = ((barWidth / maxW) * 100).toFixed(1) + '%';
      if (simScreenCm) simScreenCm.textContent = screenW + ' cm';
      if (simCm) simCm.textContent = barWidth + ' cm';
      const clearance = +(screenW - barWidth).toFixed(1);
      if (clearance >= 0) {
        simBar.classList.remove('overflow');
        result.textContent = `✅ Elle tient sous votre écran : ${(clearance / 2).toFixed(1)} cm de marge de chaque côté.`;
        result.className = 'fit-result ok';
      } else {
        simBar.classList.add('overflow');
        result.textContent = `⚠️ Elle dépasse de ${Math.abs(clearance)} cm (la barre est plus large que l'écran).`;
        result.className = 'fit-result no';
      }
    }
    input?.addEventListener('input', checkFit);
    checkFit();

    // Recommandation selon l'espace
    const roomSel = document.getElementById('room-select');
    const roomResult = document.getElementById('room-result');
    const need = { 'bureau': 5, 'grand-bureau': 20, 'petite-piece': 40, 'grande-piece': 80 };
    function checkRoom() {
      if (!roomResult || !roomSel) return;
      if (!wattsKnown) {
        roomResult.textContent = 'ℹ️ Puissance non communiquée par le constructeur — fiez-vous à nos notes Son et Basses.';
        roomResult.className = 'fit-result';
        return;
      }
      const n = need[roomSel.value];
      if (watts >= n) {
        roomResult.textContent = `✅ Puissance suffisante (${watts} W) pour ce contexte.`;
        roomResult.className = 'fit-result ok';
      } else if (watts >= n / 2) {
        roomResult.textContent = `🟡 Convient à volume modéré (${watts} W) ; un peu juste à fort volume.`;
        roomResult.className = 'fit-result';
      } else {
        roomResult.textContent = `❌ Probablement trop juste (${watts} W) pour ce contexte.`;
        roomResult.className = 'fit-result no';
      }
    }
    roomSel?.addEventListener('change', checkRoom);
    checkRoom();
  </script>
</BaseLayout>

<style>
  .product-hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    margin-top: var(--space-6);
  }
  @media (min-width: 860px) {
    .product-hero {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  .product-media {
    position: relative;
  }
  .product-info h1 {
    margin-bottom: var(--space-3);
  }
  .buybox {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .buybox-score {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  .score-big {
    font-size: 2.6rem;
    color: var(--accent);
    line-height: 1;
  }
  .score-out {
    color: var(--text-muted);
  }
  .buybox-buy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-left: auto;
  }
  .buybox-price {
    font-weight: 800;
    font-size: 1.3rem;
  }
  .buy-btn {
    justify-content: center;
    background: var(--accent);
    color: #06231b;
  }
  .buy-btn:hover {
    background: #2fe3b6;
  }
  .fit-check,
  .notice,
  .room-check {
    margin-top: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
  }
  .fit-check h2,
  .notice h2,
  .room-check h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }
  .fit-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-3) 0;
  }
  .fit-controls input,
  .fit-controls select {
    background: var(--bg-soft);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.7rem;
  }
  .fit-controls input {
    width: 120px;
  }
  .fit-result {
    font-weight: 600;
    margin: 0;
    min-height: 1.3em;
  }
  .fit-result.ok {
    color: var(--accent);
  }
  .fit-result.no {
    color: var(--danger);
  }
  .fit-hint {
    color: var(--text-muted);
    font-size: 0.8rem;
    flex-basis: 100%;
  }
  /* Simulateur 3D : moniteur à l'échelle + barre de son dessous */
  .sim3d {
    perspective: 1100px;
    margin: var(--space-4) 0 var(--space-2);
    padding: var(--space-12) var(--space-4) var(--space-8);
    background:
      radial-gradient(120% 90% at 50% 5%, rgba(79, 140, 255, 0.16), transparent),
      var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .sim3d-stage {
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
    transform: rotateX(16deg);
    transform-style: preserve-3d;
  }
  .sim3d-monitor {
    margin: 0 auto;
    transition: width 0.3s ease;
  }
  .sim3d-screen {
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    border: 4px solid #20283a;
    background:
      radial-gradient(80% 60% at 50% 30%, rgba(79, 140, 255, 0.45), transparent),
      linear-gradient(135deg, rgba(79, 140, 255, 0.32), rgba(37, 208, 164, 0.24));
    box-shadow: 0 24px 40px rgba(0, 0, 0, 0.55), inset 0 0 28px rgba(79, 140, 255, 0.28);
    display: grid;
    place-items: center;
    color: #e8ecf4;
    font-size: 0.82rem;
    font-weight: 600;
  }
  .sim3d-neck {
    width: 12px;
    height: 18px;
    margin: 0 auto;
    background: linear-gradient(#283246, #1a2233);
  }
  .sim3d-foot {
    width: 38%;
    height: 10px;
    margin: 0 auto;
    border-radius: 5px;
    background: linear-gradient(#283246, #161d2b);
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.5);
  }
  .sim3d-bar {
    margin: var(--space-6) auto 0;
    height: 34px;
    border-radius: 9px;
    background: linear-gradient(180deg, var(--primary), var(--accent));
    box-shadow:
      0 14px 24px rgba(0, 0, 0, 0.5),
      0 0 22px rgba(79, 140, 255, 0.45),
      inset 0 2px 0 rgba(255, 255, 255, 0.35);
    display: grid;
    place-items: center;
    color: #06231b;
    font-weight: 800;
    font-size: 0.8rem;
    white-space: nowrap;
    transform: translateZ(45px);
    transition: width 0.3s ease;
    -webkit-box-reflect: below 4px linear-gradient(transparent 55%, rgba(0, 0, 0, 0.28));
  }
  .sim3d-bar.overflow {
    background: repeating-linear-gradient(45deg, var(--danger) 0 9px, #a23 9px 18px);
    color: #fff;
    box-shadow:
      0 14px 24px rgba(0, 0, 0, 0.5),
      0 0 22px rgba(255, 107, 107, 0.5),
      inset 0 2px 0 rgba(255, 255, 255, 0.25);
  }
  .audience {
    margin-top: var(--space-8);
