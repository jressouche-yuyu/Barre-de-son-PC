---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProsCons from '../../components/ProsCons.astro';
import Callout from '../../components/Callout.astro';
import { soundbars, formatPrice, powerLabel } from '../../data/soundbars';
import { rankingsForSoundbar } from '../../data/rankings';
import { getGuide } from '../../data/guides';
import { getBrand } from '../../data/brands';
import {
  breadcrumbSchema,
  productReviewSchema,
  howToSchema,
} from '../../lib/schema';
import { url } from '../../lib/url';
import { amazonUrl } from '../../lib/affiliate';
import { AFFILIATE } from '../../consts';

export function getStaticPaths() {
  return soundbars.map((sb) => ({
    params: { slug: sb.slug },
    props: { sb },
  }));
}

const { sb } = Astro.props;

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Barres de son', path: '/barres-de-son' },
  { name: sb.name, path: `/barres-de-son/${sb.slug}` },
];

const scoreRows: { label: string; value: number }[] = [
  { label: 'Qualité sonore', value: sb.scores.son },
  { label: 'Basses', value: sb.scores.basses },
  { label: 'Ergonomie', value: sb.scores.ergonomie },
  { label: 'Connectique', value: sb.scores.connectique },
  { label: 'Rapport qualité-prix', value: sb.scores.rapportQualitePrix },
];

const specs: { label: string; value: string }[] = [
  { label: 'Marque', value: sb.brand },
  { label: 'Prix indicatif', value: formatPrice(sb.price, sb.currency) },
  { label: 'Haut-parleurs', value: sb.driverConfig },
  { label: 'Puissance', value: powerLabel(sb) },
  ...(sb.frequencyResponse
    ? [{ label: 'Réponse en fréquence', value: sb.frequencyResponse }]
    : []),
  { label: 'Connectique', value: sb.connectivity.join(', ') },
  { label: 'Caisson de basses', value: sb.hasSubwoofer ? 'Oui' : 'Non' },
  { label: 'Microphone', value: sb.hasMicrophone ? 'Oui' : 'Non' },
  { label: 'Éclairage RGB', value: sb.hasRGB ? 'Oui' : 'Non' },
  {
    label: 'Dimensions barre (L×H×P)',
    value: `${sb.dimensionsCm.width} × ${sb.dimensionsCm.height} × ${sb.dimensionsCm.depth} cm`,
  },
  { label: 'Année', value: String(sb.releaseYear) },
];

const brandInfo = getBrand(sb.brand.toLowerCase());
const inRankings = rankingsForSoundbar(sb.slug);

// Notice : lien direct si connu, sinon recherche de la notice officielle.
const manualIsDirect = Boolean(sb.manualUrl);
const manualHref =
  sb.manualUrl ??
  `https://www.google.com/search?q=${encodeURIComponent(`${sb.brand} ${sb.name} manuel notice pdf`)}`;
const relatedGuides = ['comment-choisir-barre-de-son-pc', 'comment-installer-barre-de-son-pc']
  .map((s) => getGuide(s))
  .filter((g): g is NonNullable<typeof g> => Boolean(g));

const jsonLd = [
  breadcrumbSchema(crumbs),
  productReviewSchema(sb),
  howToSchema(sb),
];
---

<BaseLayout
  title={`Test ${sb.name} : avis, prix et fiche technique`}
  description={sb.verdict}
  path={`/barres-de-son/${sb.slug}`}
  ogType="article"
  modifiedTime={sb.lastUpdated}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />

    <article class="product-hero">
      <div class="product-media">
        <a
          class:list={['brand-badge', brandInfo?.logoBg === 'dark' && 'badge-dark']}
          href={url(`/marques/${sb.brand.toLowerCase()}`)}
          aria-label={`Toutes les barres de son ${sb.brand}`}
        >
          {
            brandInfo?.logo ? (
              <img src={url(brandInfo.logo)} alt={`Logo ${sb.brand}`} height="18" loading="eager" />
            ) : (
              <span>{sb.brand}</span>
            )
          }
        </a>
        <img
          class="product-image"
          src={url(sb.image)}
          alt={sb.imageAlt}
          width="1200"
          height="675"
          loading="eager"
        />
      </div>

      <div class="product-info">
        <h1>{sb.name}</h1>
        <p class="lead">{sb.verdict}</p>
        <p class="badge badge-accent">🎯 Idéal pour : {sb.bestFor}</p>

        <div class="buybox">
          <div class="buybox-score">
            <span class="score-big score">{sb.score.toFixed(1)}</span>
            <span class="score-out">/ 10</span>
          </div>
          <div class="buybox-buy">
            <span class="buybox-price">{formatPrice(sb.price, sb.currency)}</span>
            {
              AFFILIATE.enabled && (
                <a
                  class="btn buy-btn"
                  href={amazonUrl(sb)}
                  target="_blank"
                  rel="sponsored nofollow noopener"
                >
                  Voir le prix sur Amazon
                </a>
              )
            }
          </div>
        </div>
      </div>
    </article>

    <Callout title="L'essentiel" icon="⚡">
      <ul>
        <li><strong>Idéal pour :</strong> {sb.bestFor}</li>
        <li><strong>Point fort :</strong> {sb.pros[0]}</li>
        <li><strong>À noter :</strong> {sb.cons[0]}</li>
        <li>
          <strong>Prix indicatif :</strong> {formatPrice(sb.price, sb.currency)} ·
          <strong> Note :</strong> {sb.score.toFixed(1)}/10
        </li>
      </ul>
    </Callout>

    <h2>Notre avis</h2>
    <p>{sb.summary}</p>

    <ProsCons pros={sb.pros} cons={sb.cons} />

    <h2>Notes détaillées</h2>
    <div class="scores">
      {
        scoreRows.map((row) => (
          <div class="score-row">
            <span class="score-label">{row.label}</span>
            <span class="score-bar" role="img" aria-label={`${row.value} sur 10`}>
              <span class="score-fill" style={`width:${row.value * 10}%`} />
            </span>
            <span class="score-val">{row.value.toFixed(1)}</span>
          </div>
        ))
      }
    </div>

    <h2>Fiche technique</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {
            specs.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td>{s.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="fit-check" aria-labelledby="fit-title">
      <h2 id="fit-title">📐 Tient-elle sous votre écran ?</h2>
      <p>
        La {sb.name} mesure <strong>{sb.dimensionsCm.width} cm</strong> de large.
        Entrez la largeur disponible sous votre moniteur pour vérifier d'un coup d'œil :
      </p>
      <div class="fit-controls">
        <label for="fit-input">Largeur dispo (cm)</label>
        <input type="number" id="fit-input" min="10" max="250" step="0.5" inputmode="decimal" placeholder="ex. 55" />
        <button type="button" id="fit-btn" class="btn">Vérifier</button>
      </div>
      <p id="fit-result" class="fit-result" role="status" aria-live="polite"></p>
    </section>

    <h2>Tutoriel : installer et configurer la {sb.name}</h2>
    <p>{sb.tutorial.intro}</p>
    <ol class="tuto-steps">
      {
        sb.tutorial.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    {
      sb.tutorial.tips && sb.tutorial.tips.length > 0 && (
        <div class="tuto-tips">
          <h3>Astuces</h3>
          <ul>
            {sb.tutorial.tips.map((tip) => <li>{tip}</li>)}
          </ul>
        </div>
      )
    }

    <section class="notice">
      <h2>📘 Notice &amp; support</h2>
      <p>
        Besoin du manuel d'utilisation de la {sb.name} (branchements, réglages,
        dépannage) ?
      </p>
      <a class="btn btn-ghost" href={manualHref} target="_blank" rel="noopener nofollow">
        {manualIsDirect ? '📄 Télécharger la notice (PDF)' : '🔎 Trouver la notice officielle'}
      </a>
    </section>

    <p class="updated">Fiche vérifiée le {sb.lastUpdated}.</p>

    <section class="maillage grid grid-2">
      {
        inRankings.length > 0 && (
          <div>
            <h2>La {sb.name} dans nos classements</h2>
            <ul>
              {inRankings.map((r) => (
                <li><a href={url(`/classements/${r.slug}`)}>{r.title}</a></li>
              ))}
            </ul>
          </div>
        )
      }
      <div>
        <h2>Guides utiles</h2>
        <ul>
          {relatedGuides.map((g) => (
            <li><a href={url(`/guides/${g.slug}`)}>{g.title}</a></li>
          ))}
          <li><a href={url('/comparateur')}>Comparer toutes les barres de son PC</a></li>
        </ul>
      </div>
    </section>

    <p style="margin-top: var(--space-8)">
      <a class="btn btn-ghost" href={url('/barres-de-son')}>← Toutes les barres de son</a>
    </p>
  </div>

  <script is:inline define:vars={{ barWidth: sb.dimensionsCm.width }}>
    const input = document.getElementById('fit-input');
    const btn = document.getElementById('fit-btn');
    const result = document.getElementById('fit-result');
    function checkFit() {
      const avail = parseFloat((input?.value || '').replace(',', '.'));
      if (!result) return;
      if (!avail || avail <= 0) {
        result.textContent = '';
        result.className = 'fit-result';
        return;
      }
      const clearance = +(avail - barWidth).toFixed(1);
      if (clearance >= 0) {
        result.textContent = `✅ Ça passe ! Il vous restera ${clearance} cm de marge sous l'écran.`;
        result.className = 'fit-result ok';
      } else {
        result.textContent = `❌ Trop large de ${Math.abs(clearance)} cm. Visez une barre plus compacte.`;
        result.className = 'fit-result no';
      }
    }
    btn?.addEventListener('click', checkFit);
    input?.addEventListener('input', checkFit);
  </script>
</BaseLayout>

<style>
  .product-hero {
    display: grid;
    gap: var(--space-8);
    align-items: center;
    margin-top: var(--space-6);
  }
  @media (min-width: 860px) {
    .product-hero {
      grid-template-columns: 1.05fr 1fr;
    }
  }
  .product-media {
    position: relative;
  }
  .product-info h1 {
    margin-bottom: var(--space-3);
  }
  .buybox {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .buybox-score {
    display: flex;
    align-items: baseline;
    gap: 2px;
  }
  .score-big {
    font-size: 2.6rem;
    color: var(--accent);
    line-height: 1;
  }
  .score-out {
    color: var(--text-muted);
  }
  .buybox-buy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-left: auto;
  }
  .buybox-price {
    font-weight: 800;
    font-size: 1.3rem;
  }
  .buy-btn {
    justify-content: center;
    background: var(--accent);
    color: #06231b;
  }
  .buy-btn:hover {
    background: #2fe3b6;
  }
  .fit-check,
  .notice {
    margin-top: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
  }
  .fit-check h2,
  .notice h2 {
    margin-top: 0;
    font-size: 1.2rem;
  }
  .fit-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-3) 0;
  }
  .fit-controls input {
    background: var(--bg-soft);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.7rem;
    width: 120px;
  }
  .fit-result {
    font-weight: 600;
    margin: 0;
    min-height: 1.3em;
  }
  .fit-result.ok {
    color: var(--accent);
  }
  .fit-result.no {
    color: var(--danger);
  }
  .scores {
    display: grid;
    gap: var(--space-3);
    max-width: 640px;
  }
  .score-row {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    align-items: center;
    gap: var(--space-3);
  }
  .score-label {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .score-bar {
    display: block;
    height: 8px;
    background: var(--surface-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .score-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
  }
  .score-val {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  th[scope='row'] {
    width: 40%;
  }
  .updated {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }
  .brand-badge {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.6rem;
    margin-bottom: var(--space-3);
    line-height: 0;
  }
  .brand-badge.badge-dark {
    background: #0b0e14;
  }
  .brand-badge img {
    height: 20px;
    width: auto;
    display: block;
  }
  .brand-badge span {
    line-height: 1;
    font-weight: 700;
    color: var(--bg);
  }
  .maillage {
    margin-top: var(--space-8);
  }
  .maillage h2 {
    font-size: 1.15rem;
    margin-top: var(--space-6);
  }
  .product-image {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    display: block;
  }
  .product-media .brand-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    margin: 0;
  }
  .tuto-steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .tuto-steps li {
    counter-increment: step;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6) var(--space-4) calc(var(--space-12) + var(--space-2));
    margin: 0;
  }
  .tuto-steps li::before {
    content: counter(step);
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: var(--primary);
    color: #fff;
    border-radius: 999px;
    font-weight: 800;
  }
  .tuto-steps h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.05rem;
  }
  .tuto-steps p {
    margin: 0;
    color: var(--text-muted);
  }
  .tuto-tips {
    margin-top: var(--space-6);
    background: rgba(79, 140, 255, 0.06);
    border: 1px solid rgba(79, 140, 255, 0.3);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6);
  }
  .tuto-tips h3 {
    margin-top: 0;
  }
  .tuto-tips ul {
    margin: 0;
  }
</style>
