---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProsCons from '../../components/ProsCons.astro';
import { soundbars, formatPrice, powerLabel } from '../../data/soundbars';
import {
  breadcrumbSchema,
  productReviewSchema,
  howToSchema,
} from '../../lib/schema';
import { url } from '../../lib/url';
import { amazonUrl } from '../../lib/affiliate';
import { AFFILIATE } from '../../consts';

export function getStaticPaths() {
  return soundbars.map((sb) => ({
    params: { slug: sb.slug },
    props: { sb },
  }));
}

const { sb } = Astro.props;

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Barres de son', path: '/barres-de-son' },
  { name: sb.name, path: `/barres-de-son/${sb.slug}` },
];

const scoreRows: { label: string; value: number }[] = [
  { label: 'Qualité sonore', value: sb.scores.son },
  { label: 'Basses', value: sb.scores.basses },
  { label: 'Ergonomie', value: sb.scores.ergonomie },
  { label: 'Connectique', value: sb.scores.connectique },
  { label: 'Rapport qualité-prix', value: sb.scores.rapportQualitePrix },
];

const specs: { label: string; value: string }[] = [
  { label: 'Marque', value: sb.brand },
  { label: 'Prix indicatif', value: formatPrice(sb.price, sb.currency) },
  { label: 'Haut-parleurs', value: sb.driverConfig },
  { label: 'Puissance', value: powerLabel(sb) },
  ...(sb.frequencyResponse
    ? [{ label: 'Réponse en fréquence', value: sb.frequencyResponse }]
    : []),
  { label: 'Connectique', value: sb.connectivity.join(', ') },
  { label: 'Caisson de basses', value: sb.hasSubwoofer ? 'Oui' : 'Non' },
  { label: 'Microphone', value: sb.hasMicrophone ? 'Oui' : 'Non' },
  { label: 'Éclairage RGB', value: sb.hasRGB ? 'Oui' : 'Non' },
  {
    label: 'Dimensions barre (L×H×P)',
    value: `${sb.dimensionsCm.width} × ${sb.dimensionsCm.height} × ${sb.dimensionsCm.depth} cm`,
  },
  { label: 'Année', value: String(sb.releaseYear) },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  productReviewSchema(sb),
  howToSchema(sb),
];
---

<BaseLayout
  title={`Test ${sb.name} : avis, prix et fiche technique`}
  description={sb.verdict}
  path={`/barres-de-son/${sb.slug}`}
  ogType="article"
  modifiedTime={sb.lastUpdated}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />

    <header class="product-head section" style="padding-bottom: var(--space-6)">
      <div>
        <p class="eyebrow">{sb.brand}</p>
        <h1>{sb.name}</h1>
        <p class="lead">{sb.verdict}</p>
        <p class="badge badge-accent">Idéal pour : {sb.bestFor}</p>
      </div>
      <div class="score-box">
        <span class="score-big score">{sb.score.toFixed(1)}</span>
        <span class="score-out">/ 10</span>
        <span class="score-price">{formatPrice(sb.price, sb.currency)}</span>
        {
          AFFILIATE.enabled && (
            <a
              class="btn buy-btn"
              href={amazonUrl(sb)}
              target="_blank"
              rel="sponsored nofollow noopener"
            >
              Voir le prix sur Amazon
            </a>
          )
        }
      </div>
    </header>

    <img
      class="product-image"
      src={url(sb.image)}
      alt={sb.imageAlt}
      width="800"
      height="500"
      loading="eager"
    />

    <h2>Notre avis</h2>
    <p>{sb.summary}</p>

    <ProsCons pros={sb.pros} cons={sb.cons} />

    <h2>Notes détaillées</h2>
    <div class="scores">
      {
        scoreRows.map((row) => (
          <div class="score-row">
            <span class="score-label">{row.label}</span>
            <span class="score-bar" role="img" aria-label={`${row.value} sur 10`}>
              <span class="score-fill" style={`width:${row.value * 10}%`} />
            </span>
            <span class="score-val">{row.value.toFixed(1)}</span>
          </div>
        ))
      }
    </div>

    <h2>Fiche technique</h2>
    <div class="table-wrap">
      <table>
        <tbody>
          {
            specs.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td>{s.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h2>Tutoriel : installer et configurer la {sb.name}</h2>
    <p>{sb.tutorial.intro}</p>
    <ol class="tuto-steps">
      {
        sb.tutorial.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </li>
        ))
      }
    </ol>
    {
      sb.tutorial.tips && sb.tutorial.tips.length > 0 && (
        <div class="tuto-tips">
          <h3>Astuces</h3>
          <ul>
            {sb.tutorial.tips.map((tip) => <li>{tip}</li>)}
          </ul>
        </div>
      )
    }

    <p class="updated">Fiche vérifiée le {sb.lastUpdated}.</p>

    <p style="margin-top: var(--space-8)">
      <a class="btn btn-ghost" href={url('/barres-de-son')}>← Toutes les barres de son</a>
    </p>
  </div>
</BaseLayout>

<style>
  .product-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    align-items: flex-start;
    justify-content: space-between;
  }
  .score-box {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    min-width: 160px;
  }
  .score-big {
    font-size: 3rem;
    color: var(--accent);
    line-height: 1;
  }
  .score-out {
    color: var(--text-muted);
  }
  .score-price {
    margin-top: var(--space-2);
    font-weight: 700;
    font-size: 1.2rem;
  }
  .buy-btn {
    margin-top: var(--space-3);
    width: 100%;
    justify-content: center;
    background: var(--accent);
    color: #06231b;
  }
  .buy-btn:hover {
    background: #2fe3b6;
  }
  .scores {
    display: grid;
    gap: var(--space-3);
    max-width: 640px;
  }
  .score-row {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    align-items: center;
    gap: var(--space-3);
  }
  .score-label {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .score-bar {
    display: block;
    height: 8px;
    background: var(--surface-2);
    border-radius: 999px;
    overflow: hidden;
  }
  .score-fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--primary), var(--accent));
  }
  .score-val {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  th[scope='row'] {
    width: 40%;
  }
  .updated {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-style: italic;
  }
  .product-image {
    width: 100%;
    max-width: 720px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    margin-block: var(--space-6) var(--space-8);
  }
  .tuto-steps {
    list-style: none;
    counter-reset: step;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .tuto-steps li {
    counter-increment: step;
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6) var(--space-4) calc(var(--space-12) + var(--space-2));
    margin: 0;
  }
  .tuto-steps li::before {
    content: counter(step);
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    background: var(--primary);
    color: #fff;
    border-radius: 999px;
    font-weight: 800;
  }
  .tuto-steps h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.05rem;
  }
  .tuto-steps p {
    margin: 0;
    color: var(--text-muted);
  }
  .tuto-tips {
    margin-top: var(--space-6);
    background: rgba(79, 140, 255, 0.06);
    border: 1px solid rgba(79, 140, 255, 0.3);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6);
  }
  .tuto-tips h3 {
    margin-top: 0;
  }
  .tuto-tips ul {
    margin: 0;
  }
</style>
