---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SoundbarCard from '../../components/SoundbarCard.astro';
import { soundbarsByScore } from '../../data/soundbars';
import { brands } from '../../data/brands';
import { breadcrumbSchema, faqSchema } from '../../lib/schema';
import { annee } from '../../lib/millesime';
import { url } from '../../lib/url';

const all = soundbarsByScore();

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Barres de son', path: '/barres-de-son' },
];

const faq = [
  {
    question: 'Combien de barres de son PC avez-vous testées ?',
    answer: `Notre base compte actuellement ${all.length} modèles dédiés à un usage PC, du premier prix au modèle premium à son 3D.`,
  },
];

const jsonLd = [breadcrumbSchema(crumbs), faqSchema(faq)];
---

<BaseLayout
  title={`Barres de son PC : tous nos tests et avis (${annee()})`}
  description="Toutes les barres de son pour PC testées et notées sur 5 critères, classées par note : Razer, Creative, Edifier, Logitech… Fiches détaillées, prix et avis."
  path="/barres-de-son"
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="section" style="padding-bottom: var(--space-4)">
      <h1>Toutes nos barres de son PC</h1>
      <p class="lead">
        {all.length} modèles testés et notés sur cinq critères, classés par note
        globale.
      </p>
    </header>

    <nav class="brand-links" aria-label="Par marque">
      <span class="brand-links-label">Par marque :</span>
      {brands.map((b) => <a href={url(`/marques/${b.slug}`)}>{b.name}</a>)}
    </nav>

    <section style="padding-bottom: var(--space-16)">
      <div class="grid grid-3">
        {all.map((sb) => <SoundbarCard soundbar={sb} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .brand-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-bottom: var(--space-8);
  }
  .brand-links-label {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .brand-links a {
    font-weight: 600;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .brand-links a:hover {
    border-color: var(--primary);
    text-decoration: none;
  }
</style>
