---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CoverArt from '../../components/CoverArt.astro';
import Faq from '../../components/Faq.astro';
import { breadcrumbSchema, blogPostingSchema, faqSchema } from '../../lib/schema';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' }).format(d);

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Blog', path: '/blog' },
  { name: post.data.title, path: `/blog/${post.id}` },
];

const faq = post.data.faq ?? [];
const sources = post.data.sources ?? [];

const jsonLd = [
  breadcrumbSchema(crumbs),
  blogPostingSchema({
    title: post.data.title,
    description: post.data.description,
    slug: post.id,
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
  }),
  // La FAQ du frontmatter alimente FAQPage : c'est la forme la plus reprise par
  // les AI Overviews. Sans cette injection, le champ `faq` ne servirait à rien.
  ...(faq.length > 0 ? [faqSchema(faq)] : []),
];
---

<BaseLayout
  title={post.data.metaTitle ?? post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}`}
  ogType="article"
  publishedTime={post.data.publishedAt.toISOString()}
  modifiedTime={(post.data.updatedAt ?? post.data.publishedAt).toISOString()}
  jsonLd={jsonLd}
>
  <article class="container article">
    <Breadcrumbs items={crumbs} />
    {
      post.data.cover ? (
        <img
          class="article-cover article-cover-img"
          src={url(post.data.cover)}
          alt={post.data.coverAlt ?? post.data.title}
          width="1200"
          height="400"
          loading="eager"
        />
      ) : (
        <CoverArt seed={post.id} variant="banner" class="article-cover" />
      )
    }
    <header class="section" style="padding-top: var(--space-6); padding-bottom: var(--space-4)">
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="meta badge">
        {dateFmt(post.data.publishedAt)} · {post.data.readingMinutes} min de lecture
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {faq.length > 0 && <Faq items={faq} />}

    {
      sources.length > 0 && (
        <section class="sources" aria-labelledby="sources-title">
          <h2 id="sources-title">Sources</h2>
          {/*
            Le site ne teste pas physiquement les produits : sa crédibilité tient
            entièrement à la traçabilité de ce qu'il avance. Ces liens sont donc
            une pièce du dispositif éditorial, pas une politesse de bas de page.
          */}
          <ul>
            {sources.map((source) => (
              <li>
                <a href={source.url} rel="nofollow noopener" target="_blank">
                  {source.title}
                </a>
                {source.publisher && <span class="source-publisher"> — {source.publisher}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p style="margin-top: var(--space-12)">
      <a class="btn btn-ghost" href={url('/blog')}>← Tous les articles</a>
    </p>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 760px;
  }
  .article-cover {
    margin-top: var(--space-6);
  }
  .sources {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .sources ul {
    padding-left: var(--space-5);
  }
  .sources li {
    margin-bottom: var(--space-2);
  }
  /* --text-muted sur --bg : 7,90:1 — bien au-delà du 4,5:1 requis. */
  .source-publisher {
    color: var(--text-muted);
  }
  .article-cover-img {
    width: 100%;
    aspect-ratio: 3 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }
  /* Images insérées dans le corps d'article */
  .prose :global(img) {
    border-radius: var(--radius);
    margin: var(--space-6) 0;
  }
  .prose :global(figure) {
    margin: var(--space-6) 0;
  }
  .prose :global(figcaption) {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-align: center;
    margin-top: var(--space-2);
  }
  .prose :global(h2) {
    margin-top: var(--space-12);
  }
  .prose :global(table) {
    margin: var(--space-4) 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: var(--space-8) 0;
  }
</style>
