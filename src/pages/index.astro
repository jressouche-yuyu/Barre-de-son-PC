---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SoundbarCard from '../components/SoundbarCard.astro';
import CoverArt from '../components/CoverArt.astro';
import Faq from '../components/Faq.astro';
import { soundbarsByScore } from '../data/soundbars';
import { rankings } from '../data/rankings';
import { guides } from '../data/guides';
import { faqSchema, breadcrumbSchema } from '../lib/schema';
import { url } from '../lib/url';

const top = soundbarsByScore().slice(0, 3);

const latestPosts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

// FAQ éditoriale ciblant « barre de son PC ». Rendue en accordéons <details>
// (présents dans le HTML statique → indexables) + exposée en FAQPage (GEO).
const homeFaq = [
  {
    question: 'Qu\'est-ce qu\'une barre de son pour PC ?',
    answer:
      'Une barre de son pour PC est une enceinte compacte et allongée qui se place sous l\'écran. Branchée le plus souvent en USB-C ou en Bluetooth, elle remplace avantageusement les haut-parleurs intégrés d\'un moniteur ou d\'un PC portable, avec des voix plus claires et des basses bien plus présentes.',
  },
  {
    question: 'Comment choisir une barre de son pour PC ?',
    answer:
      'Regardez d\'abord la connectique (USB-C idéal sur PC, Bluetooth en appoint), la présence ou non d\'un caisson de basses, l\'encombrement sous votre moniteur, et les options gaming (RGB, son spatial). Fixez ensuite un budget : nos classements par usage et notre comparateur facilitent le choix.',
  },
  {
    question: 'Quelle est la meilleure barre de son PC en 2026 ?',
    answer:
      'Pour l\'immersion gaming, la Razer Leviathan V2 Pro est notre référence. Pour la polyvalence (PC, console, TV), la Creative Sound Blaster Katana V2. À petit budget, la Creative Stage V2 offre le meilleur rapport qualité-prix. Voir notre classement général pour le détail.',
  },
  {
    question: 'Barre de son ou enceintes pour un PC ?',
    answer:
      'La barre de son gagne sur le confort, la simplicité (un seul appareil, souvent un câble USB-C) et le gain de place. Des enceintes offrent une meilleure scène stéréo mais demandent plus d\'espace. Pour un bureau chargé, la barre de son PC est généralement le choix le plus pratique.',
  },
  {
    question: 'Quel budget pour une barre de son PC ?',
    answer:
      'À partir de ~50-60 € pour une mini-barre compacte, 100-130 € pour un combo barre + caisson polyvalent, 200-300 € pour les modèles puissants et bien connectés, et au-delà de 400 € pour le son 3D premium. Notre classement des barres de son PC pas chères couvre les petits budgets.',
  },
  {
    question: 'Comment brancher une barre de son sur un PC ?',
    answer:
      'Le plus simple est l\'USB-C : un seul câble pour l\'audio (et parfois l\'alimentation), reconnu nativement par Windows. Sélectionnez ensuite la barre comme périphérique de sortie par défaut. Le Bluetooth dépanne pour le smartphone, le jack ou l\'optique pour d\'autres appareils.',
  },
  {
    question: 'Comment choisissez-vous les barres de son recommandées ?',
    answer:
      'Chaque modèle est évalué sur cinq critères : qualité sonore, basses, ergonomie sur un bureau, connectique adaptée au PC et rapport qualité-prix. Nos classements sont indépendants et réactualisés régulièrement.',
  },
];

const jsonLd = [
  breadcrumbSchema([{ name: 'Accueil', path: '/' }]),
  faqSchema(homeFaq),
];
---

<BaseLayout
  title="Barre de son PC : comparatif et meilleurs modèles 2026"
  description="Quelle barre de son pour PC choisir ? Comparatif indépendant, classements par usage et guides d'achat des meilleures barres de son PC : gaming, télétravail, petit budget."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <img
      class="hero-bg"
      src={url('/images/illustrations/hero.webp')}
      alt=""
      aria-hidden="true"
      width="1376"
      height="768"
      fetchpriority="high"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Comparatif indépendant · Mis à jour en 2026</p>
        <h1>La meilleure barre de son pour PC</h1>
        <p class="lead">
          Classements par usage, tests détaillés et guides d'achat pour choisir
          la barre de son PC idéale : gaming, télétravail, musique ou petit budget.
        </p>
        <div class="hero-actions">
          <a class="btn" href={url('/classements/meilleures-barres-de-son-pc')}>Voir le classement 2026</a>
          <a class="btn btn-ghost" href={url('/comparateur')}>Comparer les modèles</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Notre top 3 du moment</h2>
    <div class="grid grid-3">
      {top.map((sb, i) => <SoundbarCard soundbar={sb} rank={i + 1} />)}
    </div>
  </section>

  <section class="section container">
    <h2>Classements par usage</h2>
    <div class="grid grid-3">
      {
        rankings.map((r) => (
          <a class="link-card media-card" href={url(`/classements/${r.slug}`)}>
            {
              r.cover ? (
                <img class="media-thumb" src={url(r.cover)} alt={r.coverAlt ?? r.title} width="800" height="450" loading="lazy" />
              ) : (
                <CoverArt seed={r.slug} variant="thumb" icon="🏆" />
              )
            }
            <div class="media-body">
              <h3>{r.title}</h3>
              <p>{r.subtitle}</p>
              <span class="link-card-cta">Voir le classement →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <h2>Guides d'achat</h2>
    <div class="grid grid-2">
      {
        guides.map((g) => (
          <a class="link-card" href={url(`/guides/${g.slug}`)}>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
            <span class="link-card-cta">Lire le guide →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Derniers articles</h2>
      <a class="see-all" href={url('/blog')}>Tout le blog →</a>
    </div>
    <div class="grid grid-3">
      {
        latestPosts.map((post) => (
          <a class="link-card" href={url(`/blog/${post.id}`)}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="link-card-cta">Lire l'article →</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Bloc éditorial SEO (texte visible + accordéons indexables) -->
  <section class="section container editorial">
    <h2>La barre de son PC, le bon choix pour votre bureau</h2>
    <p>
      Une <strong>barre de son pour PC</strong> est une enceinte compacte et
      allongée qui se glisse sous l'écran et remplace avantageusement les
      haut-parleurs intégrés d'un moniteur ou d'un ordinateur portable. En un seul
      appareil — souvent branché par un unique câble USB-C — elle apporte des voix
      plus claires, des basses présentes et une scène sonore bien plus large, sans
      encombrer le bureau.
    </p>
    <p>
      Sur cette page, nous réunissons nos <a href={url('/classements')}>classements
      par usage</a> (gaming, télétravail, petit budget, modèles compacts ou
      polyvalents), des <a href={url('/barres-de-son')}>tests détaillés</a> modèle
      par modèle et un <a href={url('/comparateur')}>comparateur</a> pour trancher
      selon vos critères : caisson de basses, éclairage RGB, connectique ou prix.
    </p>
    <p>
      Que vous cherchiez une barre de son PC pour le jeu, la bureautique ou la
      musique, notre objectif est simple : vous aider à choisir vite et bien, avec
      des informations vérifiées et tenues à jour.
    </p>
  </section>

  <div class="container">
    <Faq items={homeFaq} title="Questions fréquentes sur les barres de son PC" />
  </div>
</BaseLayout>

<style>
  /* Hero plein impact : image en fond + voile pour la lisibilité */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: min(62svh, 560px);
    padding-block: var(--space-10);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 62%;
    z-index: -2;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(11, 14, 20, 0.92) 0%, rgba(11, 14, 20, 0.6) 55%, rgba(11, 14, 20, 0.25) 100%),
      linear-gradient(0deg, rgba(11, 14, 20, 0.85) 0%, rgba(11, 14, 20, 0.25) 45%, rgba(11, 14, 20, 0.4) 100%);
  }
  .hero-text {
    max-width: 640px;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    margin-bottom: var(--space-4);
  }
  .hero .lead {
    max-width: 52ch;
    color: #cdd5e6;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }

  .link-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    color: var(--text);
    height: 100%;
  }
  .link-card:hover {
    border-color: var(--primary);
    text-decoration: none;
  }
  .media-card {
    padding: 0;
    overflow: hidden;
  }
  .media-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .media-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .link-card h3 {
    margin: 0;
  }
  .link-card p {
    color: var(--text-muted);
    margin: 0;
  }
  .link-card-cta {
    margin-top: auto;
    color: var(--primary);
    font-weight: 600;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
  }
  .see-all {
    font-weight: 600;
    white-space: nowrap;
  }
  .editorial {
    max-width: 820px;
  }
  .editorial p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
</style>
