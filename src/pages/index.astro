---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SoundbarCard from '../components/SoundbarCard.astro';
import CoverArt from '../components/CoverArt.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../consts';
import { soundbarsByScore } from '../data/soundbars';
import { rankings } from '../data/rankings';
import { guides } from '../data/guides';
import { faqSchema, breadcrumbSchema } from '../lib/schema';
import { url } from '../lib/url';

const top = soundbarsByScore().slice(0, 3);

const latestPosts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 3);

const homeFaq = [
  {
    question: 'Qu\'est-ce qu\'une barre de son pour PC ?',
    answer:
      'C\'est une enceinte allongée conçue pour se placer devant un écran d\'ordinateur. Elle se branche généralement en USB ou Bluetooth et améliore nettement le son par rapport aux haut-parleurs intégrés d\'un moniteur ou d\'un PC portable.',
  },
  {
    question: 'Comment choisissez-vous les barres de son recommandées ?',
    answer:
      'Chaque modèle est évalué sur cinq critères : qualité sonore, basses, ergonomie sur un bureau, connectique adaptée au PC et rapport qualité-prix. Nos classements sont indépendants et réactualisés régulièrement.',
  },
];

const jsonLd = [
  breadcrumbSchema([{ name: 'Accueil', path: '/' }]),
  faqSchema(homeFaq),
];
---

<BaseLayout
  title={`${SITE.name} — ${SITE.tagline}`}
  description={SITE.description}
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Comparatif indépendant · Mis à jour en 2026</p>
        <h1>Trouvez la meilleure barre de son pour votre PC</h1>
        <p class="lead">
          Classements, tests détaillés et guides d'achat pour choisir la barre de
          son idéale selon votre usage : gaming, bureautique, musique ou home-studio.
        </p>
        <div class="hero-actions">
          <a class="btn" href={url('/classements/meilleures-barres-de-son-pc')}>Voir le classement 2026</a>
          <a class="btn btn-ghost" href={url('/comparateur')}>Comparer les modèles</a>
        </div>
      </div>
      <img
        class="hero-img"
        src={url('/images/illustrations/hero.webp')}
        alt="Barre de son sous un écran de PC avec des ondes sonores lumineuses"
        width="1376"
        height="768"
        loading="eager"
      />
    </div>
  </section>

  <section class="section container">
    <h2>Notre top 3 du moment</h2>
    <div class="grid grid-3">
      {top.map((sb, i) => <SoundbarCard soundbar={sb} rank={i + 1} />)}
    </div>
  </section>

  <section class="section container">
    <h2>Classements par usage</h2>
    <div class="grid grid-3">
      {
        rankings.map((r) => (
          <a class="link-card media-card" href={url(`/classements/${r.slug}`)}>
            {
              r.cover ? (
                <img class="media-thumb" src={url(r.cover)} alt={r.coverAlt ?? r.title} width="800" height="450" loading="lazy" />
              ) : (
                <CoverArt seed={r.slug} variant="thumb" icon="🏆" />
              )
            }
            <div class="media-body">
              <h3>{r.title}</h3>
              <p>{r.subtitle}</p>
              <span class="link-card-cta">Voir le classement →</span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <h2>Guides d'achat</h2>
    <div class="grid grid-2">
      {
        guides.map((g) => (
          <a class="link-card" href={url(`/guides/${g.slug}`)}>
            <h3>{g.title}</h3>
            <p>{g.description}</p>
            <span class="link-card-cta">Lire le guide →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Derniers articles</h2>
      <a class="see-all" href={url('/blog')}>Tout le blog →</a>
    </div>
    <div class="grid grid-3">
      {
        latestPosts.map((post) => (
          <a class="link-card" href={url(`/blog/${post.id}`)}>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="link-card-cta">Lire l'article →</span>
          </a>
        ))
      }
    </div>
  </section>

  <div class="container">
    <Faq items={homeFaq} />
  </div>
</BaseLayout>

<style>
  .hero {
    background: radial-gradient(1000px 400px at 30% -10%, rgba(79, 140, 255, 0.18), transparent);
    padding-block: var(--space-12) var(--space-8);
  }
  .hero-inner {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }
  .hero h1 {
    max-width: 16ch;
  }
  .hero .lead {
    max-width: 56ch;
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  .hero-img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  @media (min-width: 880px) {
    .hero-inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  .link-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--space-6);
    color: var(--text);
    height: 100%;
  }
  .link-card:hover {
    border-color: var(--primary);
    text-decoration: none;
  }
  .media-card {
    padding: 0;
    overflow: hidden;
  }
  .media-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .media-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .link-card h3 {
    margin: 0;
  }
  .link-card p {
    color: var(--text-muted);
    margin: 0;
  }
  .link-card-cta {
    margin-top: auto;
    color: var(--primary);
    font-weight: 600;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .section-head h2 {
    margin: 0;
  }
  .see-all {
    font-weight: 600;
    white-space: nowrap;
  }
</style>
