---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SoundbarCard from '../../components/SoundbarCard.astro';
import { brands } from '../../data/brands';
import { soundbarsByScore } from '../../data/soundbars';
import {
  breadcrumbSchema,
  soundbarsItemListSchema,
} from '../../lib/schema';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return brands.map((brand) => ({
    params: { brand: brand.slug },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const models = soundbarsByScore().filter((s) => s.brand === brand.name);

const crumbs = [
  { name: 'Accueil', path: '/' },
  { name: 'Marques', path: '/marques' },
  { name: brand.name, path: `/marques/${brand.slug}` },
];

const jsonLd = [
  breadcrumbSchema(crumbs),
  soundbarsItemListSchema(models, `Barres de son ${brand.name} pour PC`),
];
---

<BaseLayout
  title={`Barres de son ${brand.name} pour PC : modèles, tests et avis`}
  description={`Tous les modèles de barres de son ${brand.name} pour PC testés et notés : ${brand.intro.slice(0, 110)}…`}
  path={`/marques/${brand.slug}`}
  jsonLd={jsonLd}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <img
      class="brand-cover"
      src={url(brand.cover)}
      alt={brand.coverAlt}
      width="1600"
      height="900"
      loading="eager"
    />
    <div class:list={['brand-mark', brand.logo && 'has-logo']}>
      {
        brand.logo ? (
          <img class="brand-logo" src={url(brand.logo)} alt={`Logo ${brand.name}`} height="44" loading="eager" />
        ) : (
          <span class="brand-wordmark" style={`color:${brand.accent}`}>{brand.name}</span>
        )
      }
    </div>
    <header class="section" style="padding-top: var(--space-4); padding-bottom: var(--space-4)">
      <h1>Barres de son {brand.name} pour PC</h1>
      <p class="lead">{brand.intro}</p>
    </header>

    <div class="grid grid-3">
      {models.map((sb, i) => <SoundbarCard soundbar={sb} rank={i + 1} />)}
    </div>

    <section class="maillage">
      <h2>Aller plus loin</h2>
      <ul>
        <li><a href={url('/classements/meilleures-barres-de-son-pc')}>Le classement général des meilleures barres de son PC</a></li>
        <li><a href={url('/comparateur')}>Comparer toutes les barres de son PC</a></li>
        <li><a href={url('/marques')}>Voir toutes les marques</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .brand-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: var(--space-6);
    display: block;
  }
  .brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    margin: calc(-1 * var(--space-8)) auto 0;
    width: fit-content;
    padding: var(--space-3) var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    position: relative;
    z-index: 1;
  }
  .brand-mark.has-logo {
    background: #fff;
    padding: var(--space-3) var(--space-6);
  }
  .brand-wordmark {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .brand-logo {
    height: 44px;
    width: auto;
    display: block;
  }
  .maillage {
    margin-top: var(--space-12);
  }
  .maillage h2 {
    font-size: 1.15rem;
  }
</style>
